{
  "name": "Techno Workstation",
  "short_name": "Techno WS",
  "description": "Browser-Groovebox: Drum Machines, Acid-Bass, Kick/Sub, Lead, Chord-Generator, Mixer, FX und Song-Arranger.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#140b05",
